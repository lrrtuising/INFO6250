@model Lesson2.Models.Book
@{
    ViewData["Title"] = @Model.Title;
}

<h1>@Model.Title</h1>

<div class="card">
    <div class="card-body">
        <h5 class="card-title">@Model.Author</h5>
        <p class="card-text">@Model.Description</p>
        <p class="card-text"><strong>Price:</strong> $@Model.Price</p>
    </div>
</div>

<div class="mt-3">
    <a class="btn btn-primary" asp-controller="Books" asp-action="Index">Return</a>
</div>